{
  "schemaVersion": 1,
  "id": "valtic_cosmetics",
  "version": "${version}",
  "name": "Valtic Cosmetics",
  "description": "High-quality cosmetics for Valtic Launcher: Wings, Capes, Hats, Horns.",
  "authors": [
    "Valtic"
  ],
  "contact": {
    "homepage": "https://valticsmp.vercel.app/",
    "sources": "https://github.com/Flymak4/ValticLauncher"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.valtic.cosmetics.ValticCosmeticsMain"
    ],
    "client": [
      "dev.valtic.cosmetics.client.ValticCosmeticsClient"
    ]
  },
  "mixins": [
    "valtic_cosmetics.mixins.json",
    {
      "config": "valtic_cosmetics.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": "26.3"
  }
}
